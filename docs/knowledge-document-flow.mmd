flowchart LR
    classDef api fill:#F3F4F6,stroke:#4B5563,stroke-width:1.5px,color:#111827;
    classDef service fill:#EEF8EE,stroke:#2F855A,stroke-width:1.5px,color:#0F172A;
    classDef domain fill:#FFF7E8,stroke:#C05621,stroke-width:1.5px,color:#0F172A;
    classDef store fill:#FEF3C7,stroke:#D97706,stroke-width:1.5px,color:#78350F;
    classDef data fill:#FCE7F3,stroke:#BE185D,stroke-width:1.5px,color:#831843;

    subgraph API["Knowledge API"]
        direction TB
        A1["POST /files/upload"]:::api
        A2["POST /knowledge/documents/preprocess-preview"]:::api
        A3["POST /knowledge/documents"]:::api
        A4["POST /knowledge/documents/{id}/reprocess"]:::api
        A5["POST /knowledge/documents/{id}/rechunk"]:::api
        A6["DELETE /knowledge/documents/{id}"]:::api
        A7["GET /knowledge/documents"]:::api
        A8["GET /knowledge/documents/files"]:::api
        A9["GET /knowledge/documents/{id}"]:::api
    end

    subgraph WRITE["Write Path"]
        direction TB
        W1["KnowledgeDocumentApplicationService<br/>校验 chunk 参数、解析 source_path"]:::service
        W2["load_document_records<br/>从 uploaded files 读取并标准化原始记录"]:::domain
        W3["build_preprocess_preview<br/>返回 supported_rules、samples、warnings"]:::domain
        W4["KnowledgeDocumentPublisher.publish_new_version<br/>生成 document record、version、chunks"]:::domain
        W5["KnowledgeDocumentRepositoryGateway<br/>upsert record / chunks / deactivate old version"]:::store
    end

    subgraph READ["Read Path"]
        direction TB
        R1["KnowledgeDocumentQueryService.list_documents / get_document"]:::service
        R2["KnowledgeDocumentQueryService.list_file_indexes"]:::service
        R3["KnowledgeManagedFileScanner<br/>扫描 json、txt、md、csv、pdf、docx、xlsx"]:::domain
        R4["KnowledgeDocumentMapper<br/>summary / detail / file index response"]:::service
        R5["KnowledgeDocumentRepositoryGateway.list/get"]:::store
    end

    subgraph DATA["Storage"]
        direction TB
        D1["Uploaded Files Root"]:::data
        D2["Knowledge Document Repository<br/>Chroma or Elasticsearch"]:::data
    end

    A1 --> D1

    A2 --> W1
    A3 --> W1
    A4 --> W1
    A5 --> W1
    A6 --> W1

    W1 --> W2
    W2 --> W3
    W2 --> W4
    W4 --> W5
    W1 --> W5

    A7 --> R1
    A8 --> R2
    A9 --> R1
    R1 --> R5
    R2 --> R5
    R2 --> R3
    R1 --> R4
    R2 --> R4

    D1 --> W2
    D1 --> R3
    W5 --> D2
    R5 --> D2
