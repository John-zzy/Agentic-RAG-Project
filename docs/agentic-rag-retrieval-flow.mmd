flowchart TB
    A["POST /chat"] --> B["ActiveSceneChatService<br/>按 session 解析 scene"]
    B --> C["ChatService"]
    C --> D["读取 mounted_knowledge_sources"]
    D --> E["SceneDefinition.resolve_candidate_retrieval_tools(...)"]
    E --> F["scene_definition.build_retriever()<br/>AgenticRetriever.retrieve_with_trace"]

    subgraph RETRIEVE["Agentic Retrieval: docs-first 主链"]
        F --> G["Round N 选择当前 RetrievalTool"]
        G --> H{"selected_tool"}

        H -->|knowledge_document_search| I["DocumentRetrievalService.retrieve"]
        I --> I1["Semantic Retriever"]
        I --> I2["Keyword Retriever"]
        I1 --> I3["Hybrid Fusion + relevance filter"]
        I2 --> I3
        I3 --> J["RetrievalResult<br/>documents + citations + scores"]

        H -->|ecommerce extension tools| K["语义检索或结构化 lookup<br/>product / review / order / inventory / detail"]
        K --> J

        J --> L["GenericAssistantSufficiencyJudge"]
        L --> M{"next_action"}
        M -->|finish| N["聚合证据完成"]
        M -->|switch_tool| O["BusinessExtension handoff / follow-up routing"]
        O --> G
        M -->|rewrite| P["GenericAssistantQueryRewriter<br/>补充 docs / manual / FAQ 语义"]
        P --> G
        M -->|ask_user| Q["停止检索，准备兜底或追问"]
    end

    N --> R["CitationMapper<br/>统一映射 document / business evidence"]
    Q --> R2["fallback_policy.no_hit_message"]

    subgraph ANSWER["Answer Generation"]
        R --> S["构造带编号上下文 documents"]
        S --> T["LLM answer chain"]
        T --> U["ensure_answer_citation_markers<br/>正文缺失编号时补 参考来源"]
    end

    U --> V["SQLiteSessionStore.append_turn<br/>保存 answer + retrieval_snippets"]
    R2 --> V
    V --> W["返回 answer / citations / scene / agent"]
