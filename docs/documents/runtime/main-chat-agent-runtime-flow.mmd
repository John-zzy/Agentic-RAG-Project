flowchart TD
    A["POST /chat<br/>用户发送聊天请求"] --> B["ActiveSceneChatService.chat<br/>按 session.scene 找到 ChatService"]
    B --> C["ChatService._prepare_chat_turn<br/>准备 request_id、session、mounted_knowledge_sources"]
    C --> L1["ChatGraphRuntime.invoke<br/>创建 LangGraph run"]
    L1 --> CG1["ChatGraph.prepare_turn<br/>写入 session + context"]
    CG1 --> CG2["ChatGraph.select_mode<br/>调用 ModeSelector"]
    CG2 --> CG3{"route_mode"}

    CG3 -->|react| R1["react_branch<br/>invoke ReActGraph"]
    CG3 -->|plan| P1["plan_branch<br/>invoke PlanGraph"]
    CG3 -->|direct / fallback| S0["resolve_answer_mode"]

    subgraph RG["ReActGraph 子图"]
        direction TB
        R1 --> R0["initialize_run<br/>创建或恢复 ReActRun"]
        R0 --> R2["select_action<br/>LLMReActActionSelector 输出 action"]
        R2 --> R3["validate_action / route_action<br/>校验并路由 action"]
        R3 -->|tool_call| T["execute_tool<br/>ToolExecutor.execute"]
        R3 -->|final_answer| D1["direct_answer<br/>不调用 RAG，不返回 citations"]
        R3 -->|ask_user| U1["ask_user / waiting_user<br/>等待用户补充"]
        R4["record_observation / loop_or_finish<br/>记录 observation 并决定是否继续"]
        R4 -->|continue| R2
        R4 -->|finish| R5["synthesize_result<br/>投影 answer_mode / citations / trace"]
        D1 --> R5
        U1 --> R5
    end

    subgraph PG["PlanGraph 子图"]
        direction TB
        P1 --> P0["create_plan<br/>LLM structured planner 生成 PlanRun"]
        P0 --> P2["select_next_step<br/>选择依赖已满足的 step"]
        P2 --> P3["execute_step<br/>ToolExecutor 调用 step 工具"]
        P4["handle_retry<br/>继续 / 重试 / waiting_user / all done"]
        P4 -->|continue / retry| P2
        P4 -->|waiting_user| U2["handle_waiting_user<br/>等待用户补充"]
        P4 -->|all done| P5["synthesize_plan_result / synthesize_result<br/>投影 answer_mode / citations / trace"]
        U2 --> P5
    end

    T --> T1{"tool_name"}
    P3 --> T1

    T1 -->|agentic_rag_search| G1["AgenticRagToolAdapter.execute<br/>把 Agentic RAG 包装成工具"]
    T1 -->|native_rag_search| G0["NativeRagToolAdapter.execute<br/>把 Native RAG 包装成工具"]
    T1 -->|scene tool| G2["Scene Tool.execute<br/>业务查询、写操作或 ask_user"]
    G2 --> G3{"requires_user?"}
    G3 -->|true| U1
    G3 -->|false| O1["ToolObservation<br/>记录工具输出"]

    subgraph ARAG["RAG 工具内部怎么查资料"]
        direction TB
        G1 --> A1["AgenticRetriever.retrieve_with_trace<br/>开始多轮检索并记录 trace"]
        G0 --> A4
        A1 --> A2["GenericAssistantQueryRewriter.rewrite<br/>改写用户问题"]
        A2 --> A3["AgenticRetriever.next_action<br/>选择检索入口或继续改写"]
        A3 --> A4["DocumentRetrievalService.retrieve<br/>语义检索 + 关键词检索 + 合并排序"]
        A4 --> A5["RetrievalReranker.rerank<br/>重排并过滤低分结果"]
        A5 --> A6["GenericAssistantSufficiencyJudge.judge<br/>判断证据够不够回答"]
        A6 --> A7{"SufficiencyDecision.next_action"}
        A7 -->|rewrite_query / switch_tool| A2
        A7 -->|answer_with_evidence| A8["AgenticRetrievalOutcome<br/>输出 documents、citations、rounds"]
        A7 -->|ask_user / no_evidence| A9["AgenticRetrievalOutcome<br/>输出 follow_up 或 fallback decision"]
    end

    A8 --> O1
    A9 --> O1
    O1 -->|react observation| R4
    O1 -->|plan observation| P4
    R5 --> S0
    P5 --> S0
    S0 --> S1["final_synthesis<br/>证据回答 / direct_answer / follow_up / fallback"]
    S1 --> S2["persist_turn<br/>保存 checkpoint 与 Agent run state"]
    S2 --> S3["ChatResponseMixin._persist_turn<br/>保存聊天历史"]
    S3 --> S4["ChatResponse / ChatStreamEvent<br/>返回 JSON 或 SSE done"]

    U1 --> H1["HitlRuntimeMixin.create_hitl_wait<br/>保存 interrupt_id、turn_id 或 step_id"]
    U2 --> H1
    H1 --> H2["POST /chat/resume<br/>用户恢复等待点"]
    H2 --> H3{"ChatResumeRequest.action"}
    H3 -->|respond| C
    H3 -->|approve| T
    H3 -->|reject| H4["HitlRuntimeMixin.resume_hitl<br/>workflow=cancelled，turn 或 step 取消"]
