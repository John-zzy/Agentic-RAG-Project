flowchart LR
    subgraph FE["Frontend"]
        direction TB
        FE1["API Tester<br/>调试 chat / sessions / scenes 接口"]
        FE2["Knowledge Manager<br/>管理上传文件与知识文档索引"]
    end

    subgraph APP["Application Runtime"]
        direction TB
        APP1["FastAPI App / Routes<br/>统一暴露 chat、session、file、knowledge API"]
        APP2["Runtime Bootstrap<br/>装配 chat service、knowledge services、scene registry"]
        APP3["ActiveSceneChatService<br/>按 session 解析 scene 并分发请求"]
        APP4["SceneRegistry<br/>注册 generic_assistant / ecommerce scene definitions"]
        APP5["ChatService<br/>准备 turn、注入 graph deps、组装回答响应"]
        APP6["Runtime Factory<br/>按配置创建 platform ChatGraphRuntime"]
        APP7["GraphStreamEventMapper<br/>LangGraph 内部事件映射为 SSE 业务事件"]
    end

    subgraph SCENE["Scenes"]
        direction TB
        SC1["Generic Assistant SceneDefinition<br/>默认 docs-first 主链"]
        SC2["Ecommerce SceneDefinition<br/>复用 generic 主链并补充电商工具"]
        SC3["Scene Tools / HITL Policy<br/>ask_user、写操作审批、外部 API 调用"]
        SC4["Business Extensions<br/>例如 EcommerceBusinessExtension"]
    end

    subgraph PLATFORM["Platform"]
        direction TB
        subgraph AGENT["platform.agent_runtime<br/>Top-level Agent Runtime"]
            direction TB
            AR0["ChatGraphRuntime + ChatGraph<br/>run lifecycle / checkpoint / HITL / final answer graph"]
            AR1["ModeSelector<br/>简单问题 ReAct，复杂问题 Plan"]
            AR2["ReActGraph<br/>initialize / select / validate / execute / synthesize"]
            AR3["PlanGraph<br/>create_plan / execute_step / retry / synthesize"]
            AR4["ToolExecutor<br/>按 scene 白名单执行工具"]
            AR5["RAG Tool Adapters<br/>native_rag_search / agentic_rag_search"]
            AR6["Graph Logging<br/>关键节点、条件边和 LLM 输出调试日志"]
        end
        subgraph TOOLS["platform.tools<br/>Neutral Tool Protocol"]
            direction TB
            T1["base.py<br/>ToolContext / ToolResult / approval metadata"]
            T2["registry.py / adapters.py<br/>工具注册、StructuredTool、RetrievalTool adapter"]
        end
        subgraph RAG["platform.rag<br/>Modular RAG"]
            direction TB
            RAG0["contracts.py<br/>RetrievalTool / RetrievalResult / RetrievalPlan"]
            RAG1["pre_retrieval<br/>QueryRewriter / QueryRewrite"]
            RAG2["orchestration<br/>AgenticRetriever / SufficiencyDecision / no-hit fallback"]
            RAG3["retrieval.documents<br/>DocumentRetrievalService / semantic / keyword / fusion"]
            RAG4["post_retrieval<br/>RetrievalReranker / IdentityReranker"]
        end
        subgraph RET["platform.search_foundation<br/>Search Foundation"]
            direction TB
            RET1["VectorStoreDocument / VectorSearchResult"]
            RET2["EmbeddingStrategy / Vector Repository Contracts"]
        end
        subgraph WF["platform.workflow.langgraph<br/>LangGraph Runtime Foundation"]
            direction TB
            WF1["RuntimeGraphState / Config<br/>session_id、request_id、messages、answer、trace、agent audit"]
            WF2["GraphRunLifecycleRecorder + State Machine<br/>created / planning / running / waiting_user / retrying / terminal"]
            WF3["SQLiteLangGraphCheckpointer<br/>checkpoints / blobs / pending writes"]
        end
        PL3["KnowledgeDocumentApplicationService / QueryService<br/>预处理预览、注册、重处理、重分块、查询"]
        PL4["SQLiteSessionStore + PromptContextBuilder<br/>sessions / chat_turns / chat_messages 兼容读模型"]
        PL5["Model Router / LLM Client<br/>按复杂度选择模型并生成回答"]
    end

    subgraph DATA["Data Stores"]
        direction TB
        DB1["SQLite Session DB<br/>sessions / chat_turns / chat_messages"]
        DB5["SQLite LangGraph DB<br/>langgraph_checkpoints / blobs / writes"]
        DB2["Uploaded Files"]
        DB3["Chroma / Elasticsearch<br/>知识文档主记录与 chunks"]
        DB4["Ecommerce Demo JSON Data"]
    end

    subgraph EXT["External Services"]
        direction TB
        EX1["DashScope / Qwen API"]
    end

    FE1 --> APP1
    FE2 --> APP1

    APP2 --> APP4
    APP1 --> APP3
    APP1 --> PL3
    APP3 --> APP4
    APP3 --> APP5
    APP3 --> PL4
    APP5 --> APP6
    APP5 --> APP7
    APP5 --> PL4
    APP5 --> PL5

    APP4 --> SC1
